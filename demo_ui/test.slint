import { LineEdit, Button, Palette, ListView } from "std-widgets.slint";

export global Testing {
    callback onClick(string);
}

export component MainWindow inherits Window {
    property <string> message;
    title: "luau runtime";

    min-width: 300px;
    min-height: 300px;

    max-width: 300px;
    max-height: 300px;

    default-font-size: 24px;
    GridLayout {
        padding: 50px;
        spacing: 25px;

        Row {
            Text {
                text: "enter message";
                horizontal-alignment: center;
                height: 24px;
                font-size: 16px;
            }
        }

        Row {
            input := LineEdit {
                horizontal-alignment: center;
                height: 24px;
                font-size: 16px;

                accepted(text) => {
                    message = text;
                    Testing.onClick(message);
                    input.text = ""
                }
            }
        }

        Row {
            Button {
                clicked => {
                    message = input.text;
                    Testing.onClick(message);
                    input.text = ""
                }

                text: "print";
                height: 35px;
            }
        }

        Row {
            themebutton := Button {
                clicked => {
                    Palette.color-scheme = Palette.color-scheme == ColorScheme.dark
                        ? ColorScheme.light
                        : ColorScheme.dark;

                    themebutton.text = Palette.color-scheme == ColorScheme.dark
                        ? "dark"
                        : "light"
                }

                text: "darkmode";
                height: 35px;
            }
        }
    }
}
