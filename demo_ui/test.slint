import { LineEdit, Button } from "std-widgets.slint";
export component MainWindow inherits Window {
    in-out property <string> message;

    min-width: 300px;
    min-height: 300px;

    max-width: 300px;
    max-height: 300px;

    default-font-size: 24px;
    background: #313e50;
    GridLayout {
        padding: 50px;
        spacing: 25px;
        Row {
            Text {
                text: message;
                horizontal-alignment: center;
                font-weight: 900;
                height: 35px;
            }
        }

        Row {
            LineEdit {
                horizontal-alignment: center;
                height: 35px;
            }
        }

        Row {
            Button {
                text: "print";
                primary: true;
                height: 35px;
            }
        }
    }
}
